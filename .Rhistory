library(lme4)
library(lmerTest)
library(emmeans)
depth = 50
nsnp = 12
ENV = c("J","C","JC")
POP = factor(1:25)
nenv = length(ENV); npop = length(POP)
template = data.frame(
pop = rep(POP, each = nenv + 1),
env = rep(c(NA,ENV),npop),
generation = rep(c(0,rep(1, nenv)),npop)
)
# Simulate data
set.seed(123)
sim = do.call(rbind, lapply(1:nsnp, function(i){
t = template
# for this SNP, sample an anctestral allele frequency (bound between 25% and 75% for practicality)
ancestral_freq = runif(1, 0.25, 0.75)
# Allow for variation between populations
ancestral_freq = runif(npop,ancestral_freq - 0.05 , ancestral_freq + 0.05)
# Gnerate mean allele frequency change in environments; one environment is different from the others
mean_afc_env = sample(runif(2, -0.2, 0.2 )[c(rep(1,nenv-1),2)])
freqs = rep(ancestral_freq, each = nenv + 1) + rep(c(0,mean_afc_env), npop) # true frequency
alt = rbinom(length(freqs), size = depth, prob = freqs)
ref = depth - alt
out = cbind(t, alt = alt, ref = ref,
freq = alt/(alt+ref)) # observed ferquency
out$snp = i
return(out)
}))
ggplot(sim, aes(generation, freq, color = env))+
theme_classic()+
geom_point(alpha = 0.1)+
stat_summary()+
facet_wrap(~snp)
# Test environment dependant AFC for this snp
thissnp = 7
# Test environment dependant AFC for this snp
thissnp = 2
dt = subset(sim, snp == thissnp)
offset = setNames(subset(dt, generation == 0)[,c("pop","freq")], c("pop","ancestral_freq"))
dt = merge(dt, offset)
dt = subset(dt, generation == 1)
model = glm(cbind(ref,alt) ~ env + offset(qlogis(ancestral_freq)) , data = dt, family = "binomial")
emm = emmeans(model, ~ env)
# p-values
contrast(emm, interaction = "pairwise")
# difference between pops (logit scale)
as.data.frame(emm)
model_no_offset = glm(cbind(ref,alt) ~ env , data = dt, family = "binomial")
emm = emmeans(model_no_offset, ~ env)
contrast(emm, interaction = "pairwise")
contrast(emm, interaction = "pairwise")
res <- as.data.frame(contrast(emm, interaction = "pairwise"))
pvalues <- res$p.value
pvalues
as.data.frame(contrast(emm, interaction = "pairwise"))$p.value
