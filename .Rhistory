res$qtl[res$id %in% c("X:14328179:C:T" "X:15137154:C:A")]
res$id %in% c("X:14328179:C:T" "X:15137154:C:A")
res$qtl[res$id %in% c("X:14328179:C:T", "X:15137154:C:A")]
#for(i in sort(unique(res$qtl[!is.na(res$qtl)])[c(-1,-2)])){
for(i in 4:5){
topsnp = subset(res, qtl == i & topsnp == T)$id
thisqtl = res$id[which(res$qtl == i)]
load("/Users/tomparee/Documents/Documents - MacBook Pro de tom/rockmanlab/becei/RIX_fitness/fitness_cross_BLUE.Rdata")
fitness$crossID = paste0(fitness$RIX, ifelse(fitness$sexRIL1 == 'female', "-cross1","-cross2"),  ifelse(fitness$sex == 'female', "-F","-M"))
fitness = subset(fitness, !is.na(F_ROH))
fitness$genoID = fitness$genoID2 = fitness$genoIDXF = fitness$genoIDXF2 = fitness$RIX
fitness$parentalID = fitness$parentalIDX = fitness$genoIDXM = fitness$crossID
fitness$genoIDXF[fitness$sex == 'male'] = fitness$genoIDXF2[fitness$sex == 'male'] = NA
fitness$genoIDXM[fitness$sex == 'female'] =  NA
fitness$subm = ifelse(fitness$sex=='male',1,0)
fitness$subf = ifelse(fitness$sex=='female',1,0)
snps = as.data.frame(read_csv("~/Documents/Documents - MacBook Pro de tom/rockmanlab/becei/RIX_fitness/beceiPanels_snps_pruned0.999_RIX_2026.csv"))
geno <- as.matrix(fread("~/Documents/Documents - MacBook Pro de tom/rockmanlab/becei/RIX_fitness/rix_geno_pruned.csv"))
fixed = apply(geno, 1, mean) %in% c(0,1)
snps$id = paste0(snps$chrom, ':', snps$pos, ':', snps$ref, ":", snps$alt)
gt = geno[snps$id == topsnp,]
keep = !(snps$id %in% thisqtl)
snps = snps[!fixed & keep,]; geno = geno[!fixed & keep,]
isautosome = snps$chrom != 'X'
geno_auto = geno[isautosome,]
geno_auto = geno_auto[,!duplicated(tstrsplit(colnames(geno_auto), "_Ril1is")[[1]])]
colnames(geno_auto) = tstrsplit(colnames(geno_auto), "_Ril1is")[[1]]
geno_XM = geno[snps$chrom == 'X', grepl("sex:male", colnames(geno))]
geno_XF = geno[snps$chrom == 'X',grepl("sex:female", colnames(geno))]
geno_XF = geno_XF[,!duplicated( tstrsplit(colnames(geno_XF), '_Ril1is')[[1]] )]
colnames(geno_XF) = tstrsplit(colnames(geno_XF), '_Ril1is')[[1]]
colnames(geno_XM) = tstrsplit(colnames(geno_XM), '_sex:')[[1]]
noia_auto = NOIA_GRM(geno_auto, parental=NULL, type = c("additive", "dominant", "F"))
noia_auto$Fd
Amat_auto= noia_auto$A
Dmat_auto = noia_auto$D
#Pmat_auto = noia_auto$P
noia_XF = NOIA_GRM(geno_XF, parental=NULL, type = c("additive", "dominant", "F"))
Amat_XF= noia_XF$A
Dmat_XF = noia_XF$D
noia_XM = NOIA_GRM(geno_XM, parental=NULL, type = c("additive"))
Amat_XM= noia_XM$A
diag(Amat_auto) = diag(Amat_auto) + 1e-4
diag(Dmat_auto) = diag(Dmat_auto) + 1e-4
#diag(Pmat_auto) = diag(Pmat_auto) + 1e-4
diag(Amat_XF) = diag(Amat_XF) + 1e-4
diag(Dmat_XF) = diag(Dmat_XF) + 1e-4
#diag(Pmat_X) = diag(Pmat_X) + 1e-4
diag(Amat_XM) = diag(Amat_XM) + 1e-4
Fd_auto = noia_auto$Fd
Fd_XF = noia_XF$Fd
fitness$Fd = NA
Fd_M = Fd_auto[match(fitness$RIX,names(Fd_auto))]
Fd_F = (Fd_auto[match(fitness$RIX,names(Fd_auto))]*sum(snps$chrom != "X") + Fd_XF[match(fitness$RIX,names(Fd_XF))]*sum(snps$chrom == "X"))/nrow(snps)
fitness$Fd  = cbind(Fd_F,Fd_M)[cbind(1:nrow(fitness),ifelse(fitness$sex == "female",1,2))]
fitness$emmeanf = fitness$emmeanm = fitness$emmean
fitness$genoIDXM = fitness$cross
fitness$gt = gt[paste0(fitness$cross, "_sex:", fitness$sex)]
fitness$gtdom = ifelse(fitness$gt == 1, 1, 0)
prior <- c(
# Intercepts
prior(normal(0, 1), class = "Intercept", resp = "emmeanf"),
prior(normal(0, 1), class = "Intercept", resp = "emmeanm"),
# Fixed effects
prior(normal(0, 2), class = "b", resp = "emmeanf"),
prior(normal(0, 2), class = "b", resp = "emmeanm"),
# Random effects
prior(student_t(3, 0, 1.5), class = "sd", resp = "emmeanf"),
prior(student_t(3, 0, 1.5), class = "sd", resp = "emmeanm"),
# Residual SD
prior(student_t(3, 0, 1.5), class = "sigma", resp = "emmeanf"),
prior(student_t(3, 0, 1.5), class = "sigma", resp = "emmeanm")
)
ff = bf(emmeanf | se(SE, sigma = TRUE) + subset(subf) ~ 1 + Fd + gt + gtdom +
(1|p| gr(genoID, cov = A)) +
(1|p2| gr(genoID2, cov = D)) +
(1| gr(genoIDXF, cov = AXF)) +
(1| gr(genoIDXF2, cov = DXF)))
if(tstrsplit(topsnp, ":")[[1]] == "X"){
fm = bf(emmeanm | se(SE, sigma = TRUE) + subset(subm) ~ 1 +  Fd + gt +
(1|p| gr(genoID, cov = A)) +
(1|p2| gr(genoID2, cov = D)) +
(1| gr(genoIDXM, cov = AXM)))
}else{
fm = bf(emmeanm | se(SE, sigma = TRUE) + subset(subm) ~ 1 +  Fd + gt + gtdom +
(1|p| gr(genoID, cov = A)) +
(1|p2| gr(genoID2, cov = D)) +
(1| gr(genoIDXM, cov = AXM)))
}
# ff = bf(emmeanf | se(SE, sigma = TRUE) + subset(subf) ~ 1 + Fd +
#           (1|p| gr(genoID, cov = A)) +
#           (1|p2| gr(genoID2, cov = D)) +
#           (1| gr(genoIDXF, cov = AXF)) +
#           (1| gr(genoIDXF2, cov = DXF)))
#
# fm = bf(emmeanm | se(SE, sigma = TRUE) + subset(subm) ~ 1 +  Fd +
#           (1|p| gr(genoID, cov = A)) +
#           (1|p2| gr(genoID2, cov = D)) +
#           (1| gr(genoIDXM, cov = AXM)))
fit <- brm(
ff + fm + set_rescor(FALSE),
data = fitness,
data2 = list(
A = Amat_auto,
D = Dmat_auto,
AXF = Amat_XF,
DXF = Dmat_XF,
AXM = Amat_XM
),
family = gaussian(),
prior = prior,
chains = 4, iter = 13000, warmup = 9000,
seed = 123,
backend = "cmdstanr",
cores = 4,
control = list(adapt_delta = 0.95)
)
save(fit,
file = paste0("~/Documents/Documents - MacBook Pro de tom/rockmanlab/becei/RIX_fitness/",topsnp,"_brms.Rdata"))
}
