library(lme4)
library(lmerTest)
library(emmeans)
depth = 50
nsnp = 12
ENV = c("J","C","JC")
POP = factor(1:25)
nenv = length(ENV); npop = length(POP)
info = data.frame(
pop = rep(POP, each = nenv + 1),
env = rep(c(NA,ENV),npop),
generation = rep(c(0,rep(1, nenv)),npop)
)
info$ID = paste0("pop",info$pop,":",ifelse(info$generation == 0, 'ancestror', paste0("evolved_in_",info$env)))
# Simulate data
set.seed(123)
ALT = do.call(rbind, lapply(1:nsnp, function(i){
# for this SNP, sample an anctestral allele frequency (bound between 25% and 75% for practicality)
ancestral_freq = runif(1, 0.25, 0.75)
# Allow for variation between populations
ancestral_freq = runif(npop,ancestral_freq - 0.05 , ancestral_freq + 0.05)
# Gnerate mean allele frequency change in environments; one environment is different from the others
mean_afc_env = sample(runif(2, -0.2, 0.2 )[c(rep(1,nenv-1),2)])
freqs = rep(ancestral_freq, each = nenv + 1) + rep(c(0,mean_afc_env), npop)
alt = rbinom(length(freqs), size = depth, prob = freqs)
return(alt)
}))
REF = depth - ALT
# If you permute, you use the same permutated info for every SNPs
# To conserve linkage disequilbrium between SNPs
# i.e., SNPs are not independant, so they should not be independantly permuted
permutation = F
if(permutation == T){
info$env[info$generation == 1] = ave(info$env[info$generation == 1],info$pop[info$generation == 1],FUN = sample)
}
# Test environment dependant AFC for this snp
thissnp = 1
dt = cbind(info, alt = ALT[thissnp,], ref = REF[thissnp,])
